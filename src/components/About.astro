---
import { profile, education } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <figure class="portrait" data-reveal>
      {profile.photo ? (
        <img src={profile.photo} alt={profile.name} width="800" height="1000" loading="lazy" decoding="async" />
      ) : (
        <>
          <canvas class="portrait__canvas" data-portrait width="96" height="120" aria-hidden="true" />
          <figcaption class="portrait__label mono">
            <span class="portrait__rec" aria-hidden="true" />
            {t('about.portrait')} · {t('about.portrait.soon')}
            <span class="portrait__dots" aria-hidden="true">
              …
            </span>
          </figcaption>
        </>
      )}
      <span class="corner tl" aria-hidden="true"></span>
      <span class="corner tr" aria-hidden="true"></span>
      <span class="corner bl" aria-hidden="true"></span>
      <span class="corner br" aria-hidden="true"></span>
      <span class="portrait__meta mono" aria-hidden="true">
        {profile.location.coords}
      </span>
    </figure>

    <div class="about__copy">
      <span class="kicker" data-reveal>
        {t('about.kicker')}
      </span>
      <h2 id="about-title" class="section-title" data-reveal>
        {t('about.title')}
      </h2>
      <div class="about__bio">
        {profile.bio[lang].map((p, i) => (
          <p data-reveal style={`--reveal-delay:${i * 90}`}>
            {p}
          </p>
        ))}
      </div>

      <dl class="stats" data-reveal>
        {profile.stats.map((s) => (
          <div class="stat">
            <dt class="stat__label">{t(s.key)}</dt>
            <dd class="stat__value">
              {'prefix' in s && <span class="stat__affix">{s.prefix}</span>}
              <span data-count={s.value}>{s.value}</span>
              <span class="stat__affix">{s.suffix}</span>
            </dd>
          </div>
        ))}
      </dl>

      <p class="about__edu mono" data-reveal>
        <span>{education.degree[lang]}</span>
        <span class="muted">
          {education.school} · {education.period}
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }
  .portrait {
    position: sticky;
    top: 7rem;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
    isolation: isolate;
  }
  .portrait img,
  .portrait__canvas {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait__canvas {
    image-rendering: pixelated;
    opacity: 0.9;
  }
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgb(0 0 0 / 0.12) 3px 4px);
    pointer-events: none;
  }
  .portrait__label {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .portrait__rec {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 1.2s steps(2, jump-none) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
  .portrait__meta {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 1;
    font-size: 0.68rem;
    color: var(--muted);
  }
  .corner {
    position: absolute;
    z-index: 1;
    width: 18px;
    height: 18px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }
  .tl {
    top: 10px;
    left: 10px;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }
  .tr {
    top: 10px;
    right: 10px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    opacity: 0;
  }
  .bl {
    bottom: 10px;
    left: 10px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    opacity: 0;
  }
  .br {
    bottom: 10px;
    right: 10px;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }

  .about__bio {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--fg-soft);
  }
  .about__bio p:first-child {
    color: var(--fg);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 3.5rem;
    border-top: 1px solid var(--line);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 1.5rem 1.5rem 0 0;
  }
  .stat + .stat {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .stat__value {
    font-size: var(--step-4);
    font-weight: 450;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .stat__affix {
    color: var(--accent-text);
  }
  .stat__label {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--muted);
    max-width: 16ch;
  }
  .about__edu {
    display: grid;
    gap: 0.25rem;
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      position: relative;
      top: 0;
      max-width: 26rem;
    }
  }
  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stat,
    .stat + .stat {
      padding: 1.25rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>

<script>
  /**
   * Placeholder portrait: an ordered-dither (Bayer 4×4) render of drifting noise blobs —
   * a "signal acquiring" image until a real photo is set in `profile.photo`.
   */
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);

  let frame = 0;

  function start() {
    cancelAnimationFrame(frame);
    const canvas = document.querySelector<HTMLCanvasElement>('[data-portrait]');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    const { width: w, height: h } = canvas;
    const image = ctx.createImageData(w, h);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visible = false;
    const io = new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      if (visible) loop(performance.now());
    });
    io.observe(canvas);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });

    const draw = (time: number) => {
      const t = time / 1000;
      const styles = getComputedStyle(document.documentElement);
      const light = document.documentElement.dataset.theme === 'light';
      const accent = hexToRgb(styles.getPropertyValue('--accent').trim()) ?? [200, 255, 46];
      const ink: [number, number, number] = light ? [17, 18, 20] : [236, 234, 228];
      const bg: [number, number, number] = light ? [233, 230, 222] : [17, 18, 22];
      // A head-and-shoulders silhouette made from two soft fields, gently breathing.
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const nx = x / w - 0.5;
          const ny = y / h;
          const head = 1 - Math.hypot(nx * 1.25, (ny - 0.36) * 1.0) / 0.22;
          const shoulders = 1 - Math.hypot(nx * 0.75, (ny - 1.02) * 1.4) / 0.42;
          const wave = Math.sin(nx * 9 + t * 1.3) * Math.cos(ny * 7 - t * 0.9) * 0.18;
          const scan = Math.max(0, 1 - Math.abs(ny - ((t * 0.18) % 1.3)) * 18) * 0.5;
          const v = Math.max(head, shoulders) * 0.95 + wave + scan;
          const threshold = BAYER[(y % 4) * 4 + (x % 4)]!;
          const on = v > threshold;
          const useAccent = on && scan > 0.15;
          const c = on ? (useAccent ? accent : ink) : bg;
          const i = (y * w + x) * 4;
          image.data[i] = c[0];
          image.data[i + 1] = c[1];
          image.data[i + 2] = c[2];
          image.data[i + 3] = on ? 255 : 255;
        }
      }
      ctx.putImageData(image, 0, 0);
    };

    let last = 0;
    const loop = (time: number) => {
      if (!visible || !canvas.isConnected) return;
      if (time - last > 66) {
        draw(time);
        last = time;
      }
      if (!reduced) frame = requestAnimationFrame(loop);
    };
    draw(0);
  }

  function hexToRgb(hex: string): [number, number, number] | null {
    const m = /^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(hex);
    return m ? [parseInt(m[1]!, 16), parseInt(m[2]!, 16), parseInt(m[3]!, 16)] : null;
  }

  document.addEventListener('astro:page-load', start);
</script>
