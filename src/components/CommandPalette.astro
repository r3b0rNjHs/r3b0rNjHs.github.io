---
import { localePath, stripLang, useTranslations, type Lang } from '@/i18n/ui';
import { profile } from '@/data/profile';
import { projects } from '@/data/projects';
import type { Command } from '@/scripts/command-palette';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'en' ? 'es' : 'en';

const commands: Command[] = [
  { id: 'home', group: t('cmd.group.nav'), label: t('cmd.home'), hint: '/', action: { type: 'go', href: localePath(lang) } },
  { id: 'work', group: t('cmd.group.nav'), label: t('nav.work'), hint: '#work', action: { type: 'go', href: localePath(lang, '/#work') } },
  {
    id: 'about',
    group: t('cmd.group.nav'),
    label: t('nav.about'),
    hint: '#about',
    action: { type: 'go', href: localePath(lang, '/#about') },
  },
  { id: 'path', group: t('cmd.group.nav'), label: t('nav.path'), hint: '#path', action: { type: 'go', href: localePath(lang, '/#path') } },
  {
    id: 'contact',
    group: t('cmd.group.nav'),
    label: t('nav.contact'),
    hint: '#contact',
    action: { type: 'go', href: localePath(lang, '/#contact') },
  },
  ...projects.map<Command>((p) => ({
    id: `project-${p.slug}`,
    group: t('work.kicker'),
    label: p.title,
    hint: p.kind[lang],
    action: { type: 'go', href: localePath(lang, `/work/${p.slug}`) },
  })),
  { id: 'theme', group: t('cmd.group.actions'), label: t('cmd.theme'), hint: '☾ / ☀', action: { type: 'theme' } },
  {
    id: 'lang',
    group: t('cmd.group.actions'),
    label: t('cmd.lang'),
    hint: other.toUpperCase(),
    action: { type: 'go', href: localePath(other, stripLang(Astro.url.pathname)) },
  },
  {
    id: 'email',
    group: t('cmd.group.actions'),
    label: t('cmd.email'),
    hint: profile.email,
    action: { type: 'copy', value: profile.email, message: t('contact.copied') },
  },
  ...profile.socials.map<Command>((s) => ({
    id: `link-${s.label.toLowerCase()}`,
    group: t('cmd.group.links'),
    label: s.label,
    hint: s.handle,
    action: { type: 'open', href: s.href },
  })),
];
---

<dialog class="cmd" data-cmd aria-label={t('cmd.placeholder')}>
  <div class="cmd__panel">
    <div class="cmd__search">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <input
        type="text"
        data-cmd-input
        placeholder={t('cmd.placeholder')}
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmd-list"
        aria-autocomplete="list"
      />
      <kbd class="mono">esc</kbd>
    </div>
    <ul class="cmd__list" id="cmd-list" role="listbox" data-cmd-list></ul>
    <p class="cmd__empty mono" data-cmd-empty hidden>
      {t('cmd.empty')}
    </p>
    <footer class="cmd__foot mono">
      <span>
        <kbd>↑</kbd>
        <kbd>↓</kbd> navigate
      </span>
      <span>
        <kbd>↵</kbd> select
      </span>
      <span class="cmd__brand">jh://palette</span>
    </footer>
  </div>
  <script type="application/json" data-cmd-data set:html={JSON.stringify(commands)} />
</dialog>

<style>
  .cmd {
    width: min(640px, calc(100vw - 2rem));
    max-height: min(70vh, 560px);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: color-mix(in oklab, var(--bg-elev) 88%, transparent);
    backdrop-filter: blur(24px) saturate(1.5);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    color: var(--fg);
    box-shadow: 0 40px 120px -20px rgb(0 0 0 / 0.6);
    overflow: hidden;
  }
  .cmd[open] {
    animation: cmd-in 0.35s var(--ease-out);
  }
  .cmd::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(2px);
  }
  @keyframes cmd-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
  .cmd__panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .cmd__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .cmd__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: 1.05rem;
  }
  kbd {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }
  .cmd__list {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
    list-style: none;
  }
  .cmd__list :global(.cmd__group) {
    padding: 0.75rem 0.75rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cmd__list :global(.cmd__item) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.75rem;
    border-radius: 10px;
    cursor: pointer;
  }
  .cmd__list :global(.cmd__item[aria-selected='true']) {
    background: var(--bg-elev-2);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .cmd__list :global(.cmd__hint) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .cmd__empty {
    padding: 2rem;
    text-align: center;
    color: var(--muted);
  }
  .cmd__foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .cmd__foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .cmd__brand {
    margin-left: auto;
    color: var(--accent-text);
  }
  @media (hover: none) {
    .cmd__foot {
      display: none;
    }
  }
</style>

<script>
  import { initCommandPalette } from '@/scripts/command-palette';
  initCommandPalette();
</script>
