---
import { profile } from '@/data/profile';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <span class="kicker" data-reveal>
      {t('contact.kicker')}
    </span>
    <h2 id="contact-title" class="contact__title" data-split>
      <span class="split-line">
        <span style="--i:0">{t('contact.title.1')}</span>
      </span>
      <span class="split-line">
        <span style="--i:1">
          {t('contact.title.2')} <em class="serif">{t('contact.title.3')}</em>
        </span>
      </span>
    </h2>

    <div class="contact__grid">
      <p class="contact__lede" data-reveal>
        {t('contact.lede')}
      </p>

      <div class="contact__actions" data-reveal>
        <a class="mail" href={`mailto:${profile.email}`} data-magnetic="0.12">
          <span class="mail__label mono">Email</span>
          <span class="mail__address">{profile.email}</span>
          <span class="mail__arrow" aria-hidden="true">
            ↗
          </span>
        </a>
        <button class="btn btn--ghost copy" type="button" data-copy={profile.email} data-copied={t('contact.copied')}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
            <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
          {t('contact.copy')}
        </button>
        <ul class="socials" role="list">
          {profile.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener me" class="social">
                <span>{s.label}</span>
                <span class="mono muted">{s.handle}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .contact__title {
    margin-top: 1.5rem;
    font-size: var(--step-5);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 450;
  }
  .contact__title em {
    color: var(--accent-text);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }
  .contact__lede {
    font-size: var(--step-1);
    color: var(--fg-soft);
    max-width: 30rem;
  }
  .contact__actions {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .mail {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    width: 100%;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-elev);
    overflow: hidden;
    isolation: isolate;
    transition:
      color 0.5s var(--ease-out),
      border-color 0.5s;
  }
  .mail::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    clip-path: circle(0% at 100% 100%);
    transition: clip-path 0.8s var(--ease-out);
  }
  .mail:hover,
  .mail:focus-visible {
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .mail:hover::before,
  .mail:focus-visible::before {
    clip-path: circle(150% at 100% 100%);
  }
  .mail__label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .mail__address {
    grid-column: 1;
    margin-top: 0.5rem;
    font-size: clamp(1.15rem, 0.8rem + 1.8vw, 2.4rem);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .mail__arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-size: 1.75rem;
    transition: transform 0.5s var(--ease-out);
  }
  .mail:hover .mail__arrow {
    transform: translate(4px, -4px);
  }
  .copy {
    font-size: 0.85rem;
  }
  .socials {
    display: grid;
    width: 100%;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .social {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
    transition: padding 0.4s var(--ease-out);
  }
  .social:hover {
    padding-left: 0.75rem;
  }
  .social .mono {
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .social .mono {
      display: none;
    }
  }
</style>
