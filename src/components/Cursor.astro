---
/** A trailing ring that complements (never replaces) the native cursor on fine pointers. */
---

<div class="cursor" data-cursor aria-hidden="true">
  <span class="cursor__label" data-cursor-label></span>
</div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border: 1px solid var(--fg);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: difference;
    transition:
      width 0.4s var(--ease-out),
      height 0.4s var(--ease-out),
      margin 0.4s var(--ease-out),
      opacity 0.3s,
      background-color 0.4s,
      border-color 0.4s;
  }
  :global([data-theme='light']) .cursor {
    mix-blend-mode: normal;
    border-color: var(--fg);
  }
  .cursor.is-visible {
    opacity: 0.6;
  }
  .cursor.is-hover {
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    opacity: 1;
    border-color: var(--accent);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    mix-blend-mode: normal;
  }
  .cursor.is-label {
    width: 92px;
    height: 92px;
    margin: -46px 0 0 -46px;
    background: var(--accent);
    border-color: var(--accent);
    opacity: 1;
    mix-blend-mode: normal;
  }
  .cursor__label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .is-label .cursor__label {
    opacity: 1;
  }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .cursor {
      display: none;
    }
  }
</style>

<script>
  import { damp } from '@/lib/math';

  if (matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let x = -100,
      y = -100,
      tx = -100,
      ty = -100,
      last = performance.now(),
      running = false;

    const el = () => document.querySelector<HTMLElement>('[data-cursor]');

    const tick = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      x = damp(x, tx, 18, dt);
      y = damp(y, ty, 18, dt);
      const cursor = el();
      if (cursor) cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      running = Math.abs(x - tx) + Math.abs(y - ty) > 0.1;
      if (running) requestAnimationFrame(tick);
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        tx = e.clientX;
        ty = e.clientY;
        const cursor = el();
        if (!cursor) return;
        cursor.classList.add('is-visible');
        const target = e.target as HTMLElement;
        const labelled = target.closest<HTMLElement>('[data-cursor-text]');
        const interactive = target.closest('a, button, [role="button"], input, label');
        cursor.classList.toggle('is-label', !!labelled);
        cursor.classList.toggle('is-hover', !labelled && !!interactive);
        const label = cursor.querySelector('[data-cursor-label]');
        if (label) label.textContent = labelled?.dataset.cursorText ?? '';
        if (!running) {
          running = true;
          last = performance.now();
          requestAnimationFrame(tick);
        }
      },
      { passive: true },
    );
    document.addEventListener('pointerleave', () => el()?.classList.remove('is-visible'));
  }
</script>
