---
import { localePath, useTranslations, type Lang } from '@/i18n/ui';
import { profile } from '@/data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Three visual lines: lead-in · highlighted concept (+ optional trailing word) · muted payoff.
const lines = [
  { parts: [{ text: t('hero.title.1') }] },
  { parts: [{ text: t('hero.title.2'), serif: true }, { text: t('hero.title.3') }] },
  { parts: [{ text: t('hero.title.4') }], dim: true },
];
const fullTitle = lines.flatMap((l) => l.parts.map((p) => p.text)).filter(Boolean).join(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__canvas" data-hero-stage aria-hidden="true">
    <canvas data-hero-canvas></canvas>
    <div class="hero__fallback"></div>
  </div>

  <div class="hero__grid container">
    <div class="hero__top mono" data-reveal style="--reveal-delay: 100">
      <span class="status"><span class="status__dot"></span>{t('hero.status')}</span>
      <span class="hero__meta">
        <span>{profile.location.coords}</span>
        <span aria-hidden="true">·</span>
        <span>{t('hero.local')} <time data-clock={profile.location.tz}>--:--</time></span>
      </span>
    </div>

    <div class="hero__body">
      <p class="hero__role mono" data-reveal style="--reveal-delay: 200">
        <span class="hero__role-line" aria-hidden="true"></span>
        {t('hero.role')}
      </p>
      <h1 id="hero-title" class="hero__title" data-split>
        <span class="visually-hidden">{fullTitle}</span>
        <span aria-hidden="true">
        {
          lines.map((line, i) => (
            <span class:list={['split-line', { dim: line.dim }]}>
              <span style={`--i:${i}; --base-delay: 250ms`}>
                {line.parts
                  .filter((part) => part.text)
                  .map((part, j) => (
                    <>
                      {j > 0 && ' '}
                      <span class:list={{ serif: part.serif }}>{part.text}</span>
                    </>
                  ))}
              </span>
            </span>
          ))
        }
        </span>
      </h1>
      <p class="hero__lede" data-reveal style="--reveal-delay: 700">{t('hero.lede')}</p>
      <div class="hero__ctas" data-reveal style="--reveal-delay: 850">
        <a class="btn" href={localePath(lang, '/#work')} data-magnetic="0.25">
          {t('hero.cta.work')}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={localePath(lang, '/#contact')} data-magnetic="0.25">
          {t('hero.cta.contact')}
        </a>
      </div>
    </div>

    <div class="hero__bottom mono" data-reveal style="--reveal-delay: 1100">
      <span class="hero__hint">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
          ><circle cx="8" cy="8" r="2" fill="currentColor"></circle><circle
            cx="8"
            cy="8"
            r="6"
            fill="none"
            stroke="currentColor"
            stroke-opacity=".5"></circle></svg
        >
        {t('hero.hint')}
      </span>
      <span class="hero__hud" aria-hidden="true">signals&nbsp;<span data-pulse-count>000</span></span>
      <a class="hero__scroll" href={localePath(lang, '/#about')}>
        {t('hero.scroll')}
        <span class="hero__scroll-bar" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    isolation: isolate;
    overflow: clip;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__canvas canvas {
    position: absolute;
    top: 0;
    right: -8vw;
    width: min(78vw, 1150px);
    height: 100%;
    opacity: 0;
    transition: opacity 1.8s var(--ease-out);
  }
  .hero__canvas.is-ready canvas {
    opacity: 1;
  }
  .hero__fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 50% at 72% 45%, var(--accent-glow), transparent 70%),
      radial-gradient(60% 60% at 70% 50%, color-mix(in oklab, var(--fg) 6%, transparent), transparent 70%);
    opacity: 0.6;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero__canvas.is-ready .hero__fallback {
    opacity: 0;
  }
  /* Soft vignette so copy always wins against the field. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--bg) 0%, color-mix(in oklab, var(--bg) 70%, transparent) 38%, transparent 62%),
      linear-gradient(0deg, var(--bg) 0%, transparent 22%);
  }

  .hero__grid {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: 6.5rem;
    padding-bottom: 2rem;
    pointer-events: none;
  }
  .hero__grid :is(a, button, time) {
    pointer-events: auto;
  }
  .hero__top,
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.8rem 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 60%, transparent);
    color: var(--fg-soft);
  }
  .status__dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .status__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2.2s var(--ease-out) infinite;
  }
  @keyframes ping {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
  .hero__meta {
    display: flex;
    gap: 0.6rem;
  }

  .hero__body {
    align-self: center;
    padding-block: 3rem;
    max-width: 62rem;
  }
  .hero__role {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.75rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .hero__role-line {
    width: 2.5rem;
    height: 1px;
    background: currentColor;
  }
  .hero__title {
    /* Fit three lines plus the lede and CTAs within the first viewport on laptops. */
    font-size: min(var(--step-5), 12.5svh);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 450;
  }
  .hero__title .serif {
    color: var(--accent-text);
    padding-right: 0.04em;
  }
  .hero__title .dim > span {
    color: var(--muted);
  }
  .hero__lede {
    max-width: 34rem;
    margin-top: 2rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--fg-soft);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .hero__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .hero__hud {
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hero__scroll-bar {
    position: relative;
    width: 3rem;
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .hero__scroll-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fg);
    animation: scan 2.4s var(--ease-in-out) infinite;
  }
  @keyframes scan {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(100%);
    }
  }

  @media (max-width: 860px) {
    .hero__canvas canvas {
      inset: 0;
      right: auto;
      width: 100%;
      opacity: 0;
    }
    .hero__canvas.is-ready canvas {
      opacity: 0.55;
    }
    .hero::before {
      background: linear-gradient(0deg, var(--bg) 0%, color-mix(in oklab, var(--bg) 55%, transparent) 60%, transparent 100%);
    }
    .hero__meta > :not(:last-child),
    .hero__hud {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .hero__hint {
      display: none;
    }
    .hero__bottom {
      justify-content: flex-end;
    }
  }
</style>

<script>
  import type { NeuralField } from '@/scripts/hero/scene';

  let field: NeuralField | null = null;
  let onTheme: (() => void) | null = null;

  async function mount() {
    const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (!stage || !canvas) return;

    const { NeuralField, supportsWebGL } = await import('@/scripts/hero/scene');
    if (!supportsWebGL() || !canvas.isConnected) return;

    const counter = document.querySelector<HTMLElement>('[data-pulse-count]');
    let pulses = 0;
    field = new NeuralField({
      canvas,
      reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
      onPulse: () => {
        pulses++;
        if (counter) counter.textContent = String(pulses).padStart(3, '0');
      },
    });
    onTheme = () => field?.applyPalette();
    window.addEventListener('themechange', onTheme);
    requestAnimationFrame(() => stage.classList.add('is-ready'));
  }

  function unmount() {
    field?.dispose();
    field = null;
    if (onTheme) window.removeEventListener('themechange', onTheme);
    onTheme = null;
  }

  document.addEventListener('astro:page-load', () => {
    unmount();
    // Defer the WebGL boot until the browser is idle so text paints first (better LCP).
    const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 120));
    idle(() => void mount());
  });
  document.addEventListener('astro:before-swap', unmount);
</script>
