---
/**
 * Deterministic generative artwork for a project. Used where there are no screenshots
 * (private products) so every case study still gets a distinctive, on-brand visual.
 */
import { createRng, hashString } from '@/lib/math';
import type { Project } from '@/data/projects';

interface Props {
  project: Pick<Project, 'slug' | 'title' | 'hue' | 'motif'>;
  class?: string;
}
const { project, class: className } = Astro.props;
const rng = createRng(hashString(project.slug));
const W = 800;
const H = 500;
const cx = W * 0.62;
const cy = H * 0.5;
const id = `cover-${project.slug}`;

type Shape = { d?: string; cx?: number; cy?: number; r?: number; x?: number; y?: number; w?: number; h?: number; o: number };
const shapes: Shape[] = [];
const dots: { x: number; y: number; r: number; o: number }[] = [];

switch (project.motif) {
  case 'orbits': {
    for (let i = 0; i < 7; i++) shapes.push({ cx, cy, r: 40 + i * 34, o: 0.1 + (i % 2) * 0.12 });
    for (let i = 0; i < 26; i++) {
      const ring = 1 + Math.floor(rng() * 6);
      const a = rng() * Math.PI * 2;
      dots.push({ x: cx + Math.cos(a) * (40 + ring * 34), y: cy + Math.sin(a) * (40 + ring * 34), r: 2 + rng() * 5, o: 0.5 + rng() * 0.5 });
    }
    break;
  }
  case 'graph': {
    const nodes = Array.from({ length: 22 }, () => ({ x: W * 0.3 + rng() * W * 0.65, y: 40 + rng() * (H - 80) }));
    nodes.forEach((a, i) => {
      const near = nodes
        .map((b, j) => ({ j, d: Math.hypot(a.x - b.x, a.y - b.y) }))
        .filter((n) => n.j !== i)
        .sort((p, q) => p.d - q.d)
        .slice(0, 2);
      near.forEach(({ j }) => shapes.push({ d: `M${a.x} ${a.y}L${nodes[j]!.x} ${nodes[j]!.y}`, o: 0.25 }));
    });
    nodes.forEach((n, i) => dots.push({ x: n.x, y: n.y, r: i % 5 === 0 ? 9 : 3 + rng() * 3, o: i % 5 === 0 ? 1 : 0.7 }));
    break;
  }
  case 'ledger': {
    for (let i = 0; i < 12; i++) {
      const y = 60 + i * 32;
      const w = 120 + rng() * 300;
      shapes.push({ x: W - 60 - w, y, w, h: 10, o: 0.12 + rng() * 0.25 });
      shapes.push({ x: W * 0.3, y, w: 60 + rng() * 40, h: 10, o: 0.12 });
    }
    shapes.push({ d: `M${W * 0.3} ${H - 50}H${W - 60}`, o: 0.6 });
    dots.push({ x: W - 60, y: H - 50, r: 8, o: 1 });
    break;
  }
  case 'hexagon': {
    const size = 34;
    for (let row = -1; row < 9; row++) {
      for (let col = 0; col < 12; col++) {
        const x = W * 0.25 + col * size * 1.5;
        const y = row * size * 1.732 + (col % 2 ? size * 0.866 : 0);
        if (rng() > 0.55) continue;
        const pts = Array.from({ length: 6 }, (_, k) => {
          const a = (Math.PI / 3) * k;
          return `${(x + Math.cos(a) * size * 0.9).toFixed(1)},${(y + Math.sin(a) * size * 0.9).toFixed(1)}`;
        });
        shapes.push({ d: `M${pts.join('L')}Z`, o: rng() > 0.85 ? 0.9 : 0.15 + rng() * 0.2 });
      }
    }
    break;
  }
  case 'radar': {
    for (let i = 1; i <= 5; i++) shapes.push({ cx, cy, r: i * 44, o: 0.14 });
    for (let i = 0; i < 12; i++) {
      const a = (i / 12) * Math.PI * 2;
      shapes.push({ d: `M${cx} ${cy}L${cx + Math.cos(a) * 220} ${cy + Math.sin(a) * 220}`, o: 0.1 });
    }
    shapes.push({ d: `M${cx} ${cy}L${cx + 220} ${cy - 40}A224 224 0 0 0 ${cx + 190} ${cy - 120}Z`, o: 0.35 });
    for (let i = 0; i < 14; i++) {
      const a = rng() * Math.PI * 2;
      const r = 30 + rng() * 190;
      dots.push({ x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r, r: 2 + rng() * 4, o: 0.5 + rng() * 0.5 });
    }
    break;
  }
  case 'grid': {
    const cols = 9;
    const rows = 6;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const x = W * 0.32 + c * 56;
        const y = 50 + r * 70;
        shapes.push({ x, y, w: 40, h: 40, o: rng() > 0.8 ? 0.85 : 0.1 + rng() * 0.12 });
      }
    }
    break;
  }
}
---

<svg class:list={['cover', className]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label={project.title} style={`--hue:${project.hue}`}>
  <defs>
    <radialGradient id={`${id}-glow`} cx="65%" cy="50%" r="60%">
      <stop offset="0" stop-color={`hsl(${project.hue} 90% 60% / .45)`}></stop>
      <stop offset="1" stop-color={`hsl(${project.hue} 90% 50% / 0)`}></stop>
    </radialGradient>
    <pattern id={`${id}-dots`} width="16" height="16" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="1" fill="currentColor" opacity=".18"></circle>
    </pattern>
  </defs>
  <rect width={W} height={H} fill="var(--bg-elev)"></rect>
  <rect width={W} height={H} fill={`url(#${id}-dots)`}></rect>
  <rect width={W} height={H} fill={`url(#${id}-glow)`}></rect>
  <g fill="none" stroke={`hsl(${project.hue} 95% 62%)`} stroke-width="1.4">
    {
      shapes.map((s) =>
        s.d ? (
          <path d={s.d} opacity={s.o} fill={project.motif === 'hexagon' || project.motif === 'radar' ? `hsl(${project.hue} 95% 62% / ${s.o * 0.4})` : 'none'} />
        ) : s.r !== undefined ? (
          <circle cx={s.cx} cy={s.cy} r={s.r} opacity={s.o} />
        ) : (
          <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="3" opacity={s.o} fill={`hsl(${project.hue} 95% 62% / ${s.o * 0.6})`} />
        ),
      )
    }
  </g>
  <g fill={`hsl(${project.hue} 95% 66%)`}>
    {dots.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.r.toFixed(1)} opacity={d.o.toFixed(2)} />)}
  </g>
  <text x="40" y={H - 40} fill="currentColor" opacity=".55" font-family="var(--font-mono)" font-size="14" letter-spacing="2">
    {project.slug.toUpperCase().replace(/-/g, '_')}
  </text>
</svg>

<style>
  .cover {
    width: 100%;
    height: 100%;
    color: var(--fg);
  }
</style>
