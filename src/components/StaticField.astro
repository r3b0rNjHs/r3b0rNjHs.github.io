---
/**
 * Build-time SVG snapshot of the neural field. It is what visitors see before WebGL boots,
 * and permanently on devices without a hardware GPU, with JavaScript disabled or with reduced data.
 */
import { createRng } from '@/lib/math';
import { fibonacciSphere, nearestNeighbourEdges, rotatePoints } from '@/lib/geometry';

const COUNT = 320;
const base = fibonacciSphere(COUNT, 0.05, 7);
const points = rotatePoints(base, 0.35, -0.6);
const rng = createRng(20181001);
const hubs = Array.from({ length: 140 }, () => Math.floor(rng() * COUNT));
const edges = nearestNeighbourEdges(base, hubs, 2, 0.5).filter(([a, b]) => points[a * 3 + 2]! > -0.2 && points[b * 3 + 2]! > -0.2);

const r = (v: number) => Math.round(v * 1000) / 1000;
const nodes = Array.from({ length: COUNT }, (_, i) => ({
  x: r(points[i * 3]!),
  y: r(-points[i * 3 + 1]!),
  depth: points[i * 3 + 2]!,
  accent: rng() > 0.93,
}));
---

<!-- The viewBox matches the WebGL camera framing, so the swap to the live field is seamless. -->
<svg class="static-field" viewBox="-1.37 -1.37 2.74 2.74" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <g class="static-field__links">
    {edges.map(([a, b]) => (
      <line x1={nodes[a]!.x} y1={nodes[a]!.y} x2={nodes[b]!.x} y2={nodes[b]!.y} />
    ))}
  </g>
  {nodes.map((n) => (
    <circle
      cx={n.x}
      cy={n.y}
      r={n.accent ? 0.011 : 0.0065}
      class:list={{ accent: n.accent }}
      opacity={r(n.depth > 0 ? 0.55 + n.depth * 0.45 : 0.12 + (1 + n.depth) * 0.25)}
    />
  ))}
</svg>

<style>
  .static-field {
    width: 100%;
    height: 100%;
    fill: var(--fg);
  }
  .static-field__links {
    stroke: var(--fg);
    stroke-opacity: 0.12;
    stroke-width: 0.003;
  }
  .accent {
    fill: var(--accent);
  }
</style>
