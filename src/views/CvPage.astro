---
import Base from '@/layouts/Base.astro';
import { education, experience, profile, stack } from '@/data/profile';
import { projects } from '@/data/projects';
import { cvPdfPath } from '@/lib/cv';
import { localePath, useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site?.host ?? 'r3b0rnjhs.github.io';
const linkedin = profile.socials.find((s) => s.label === 'LinkedIn');
const github = profile.socials.find((s) => s.label === 'GitHub');
---

<Base title={`${t('cv.title')} · ${profile.name}`} description={t('meta.description')}>
  <div class="cv-page container">
    <div class="cv-actions" data-cv-actions>
      <a class="btn" href={cvPdfPath(lang)} download>
        {t('cv.download')}
        <span class="arrow" aria-hidden="true">
          ↓
        </span>
      </a>
      <button class="btn btn--ghost" type="button" data-print>
        {t('cv.print')}
      </button>
    </div>

    <article class="sheet" aria-label={`${t('cv.title')} · ${profile.name}`}>
      <header class="head">
        <div>
          <h1 class="name">{profile.name}</h1>
          <p class="role">{t('hero.role')}</p>
        </div>
        <ul class="contact" role="list">
          <li>
            {profile.location.city}, {lang === 'es' ? 'España' : profile.location.country}
          </li>
          <li>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
          <li>
            <a href={new URL(localePath(lang), Astro.site)}>{site}</a>
          </li>
          {linkedin && (
            <li>
              <a href={linkedin.href}>linkedin.com/{linkedin.handle}</a>
            </li>
          )}
          {github && (
            <li>
              <a href={github.href}>github.com/{github.handle.replace('@', '')}</a>
            </li>
          )}
        </ul>
      </header>
      <p class="availability">{profile.availability[lang]}</p>

      <section class="block">
        <h2>{t('cv.summary')}</h2>
        <div class="prose">
          {profile.bio[lang].map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>

      <section class="block">
        <h2>{t('cv.experience')}</h2>
        <ol class="entries" role="list">
          {experience.map((job) => (
            <li class="entry">
              <div class="entry__head">
                <h3>
                  {job.role[lang]} <span class="at">· {job.company}</span>
                </h3>
                <span class="when">{job.period[lang]}</span>
              </div>
              <p>{job.summary[lang]}</p>
              <p class="tags">{job.tags.join(' · ')}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="block">
        <h2>{t('cv.projects')}</h2>
        <ol class="entries" role="list">
          {projects.map((p) => (
            <li class="entry">
              <div class="entry__head">
                <h3>
                  {p.title} <span class="at">· {p.role[lang]}</span>
                </h3>
                <span class="when">{p.year}</span>
              </div>
              <p>{p.tagline[lang]}</p>
              <p class="tags">{p.stack.slice(0, 7).join(' · ')}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="block">
        <h2>{t('cv.skills')}</h2>
        <dl class="skills">
          {stack.map((group) => (
            <div>
              <dt>{group.group[lang]}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="block">
        <h2>{t('cv.education')}</h2>
        <div class="entry">
          <div class="entry__head">
            <h3>{education.degree[lang]}</h3>
            <span class="when">{education.period}</span>
          </div>
          <p>{education.school}</p>
        </div>
      </section>

      <section class="block">
        <h2>{t('cv.languages')}</h2>
        <p>{profile.languages[lang]}</p>
      </section>
    </article>
  </div>
</Base>

<style>
  /* The CV is a document: it keeps a paper look in both themes and prints to A4. */
  .cv-page {
    padding-top: 7rem;
    padding-bottom: 5rem;
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .sheet {
    --ink: #15161a;
    --ink-soft: #3d3e44;
    --ink-muted: #6a6a66;
    --rule: #dcd9d1;
    --mark: #4a6400;
    max-width: 210mm;
    margin-inline: auto;
    padding: 16mm 16mm 14mm;
    background: #fdfcf9;
    color: var(--ink);
    border-radius: 6px;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.5);
    font-size: 10pt;
    line-height: 1.45;
  }
  .head {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 5mm;
    border-bottom: 1.5px solid var(--ink);
  }
  .name {
    font-size: 24pt;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .role {
    margin-top: 1.5mm;
    font-family: var(--font-mono);
    font-size: 8.5pt;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mark);
  }
  .contact {
    display: grid;
    gap: 0.5mm;
    text-align: right;
    font-size: 8.5pt;
    color: var(--ink-soft);
  }
  .contact a {
    color: inherit;
  }
  .availability {
    margin-top: 3mm;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--ink-muted);
  }
  .block {
    display: grid;
    grid-template-columns: 30mm 1fr;
    gap: 6mm;
    padding-block: 4.5mm;
    border-bottom: 1px solid var(--rule);
  }
  .block:last-child {
    border-bottom: 0;
  }
  .block h2 {
    padding-top: 0.6mm;
    font-family: var(--font-mono);
    font-size: 7.5pt;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .block > :not(h2) {
    grid-column: 2;
  }
  .prose {
    display: grid;
    gap: 2mm;
    color: var(--ink-soft);
  }
  .entries {
    display: grid;
    gap: 3.5mm;
  }
  .entry {
    break-inside: avoid;
  }
  .entry p {
    color: var(--ink-soft);
  }
  .entry__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
    margin-bottom: 0.8mm;
  }
  .entry__head h3 {
    font-size: 10.5pt;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .at {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .when {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--ink-muted);
  }
  .tags {
    margin-top: 0.8mm;
    font-family: var(--font-mono);
    font-size: 7.5pt;
    color: var(--ink-muted) !important;
  }
  .skills {
    display: grid;
    gap: 1.2mm;
  }
  .skills div {
    display: grid;
    grid-template-columns: 34mm 1fr;
    gap: 3mm;
  }
  .skills dt {
    font-weight: 600;
  }
  .skills dd {
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .sheet {
      padding: 1.5rem 1.25rem;
      font-size: 0.9rem;
    }
    .head {
      flex-direction: column;
      gap: 1rem;
    }
    .contact {
      text-align: left;
    }
    .block,
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .block > :not(h2) {
      grid-column: 1;
    }
    .entry__head {
      flex-direction: column;
      gap: 0.1rem;
    }
  }

  @page {
    size: A4;
    margin: 13mm 15mm 12mm;
  }
  @media print {
    :global(.nav),
    :global(.footer),
    :global(.cursor),
    :global(.skip-link),
    :global(.cmd),
    .cv-actions {
      display: none !important;
    }
    :global(body) {
      background: #fff !important;
    }
    :global(body::after) {
      display: none;
    }
    .cv-page {
      padding: 0;
      max-width: none;
    }
    .sheet {
      max-width: none;
      border-radius: 0;
      box-shadow: none;
      padding: 0;
      background: #fff;
    }
    a {
      text-decoration: none;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  });
</script>
