---
import Base from '@/layouts/Base.astro';
import { education, experience, profile, stack } from '@/data/profile';
import { projects } from '@/data/projects';
import { cvPdfPath } from '@/lib/cv';
import QRCode from 'qrcode';
import { localePath, useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site?.host ?? 'r3b0rnjhs.github.io';
const linkedin = profile.socials.find((s) => s.label === 'LinkedIn');
const github = profile.socials.find((s) => s.label === 'GitHub');
const portfolioUrl = new URL(localePath(lang), Astro.site).toString();
/** QR to the portfolio, rendered at build time so a printed CV still leads to the live site. */
const qr = await QRCode.toString(portfolioUrl, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#15161aff', light: '#00000000' },
});
const workUrl = (slug: string) => new URL(localePath(lang, `/work/${slug}/`), Astro.site);
---

<Base title={`${t('cv.title')} · ${profile.name}`} description={t('meta.description')}>
  <div class="cv-page container">
    <a class="cv-close" href={localePath(lang, '/#about')} data-cv-close aria-label={t('cv.close')} title={`${t('cv.close')} (Esc)`}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </a>

    <div class="cv-actions" data-cv-actions>
      <a class="btn btn--ghost cv-back" href={localePath(lang, '/#about')} data-cv-close>
        <span aria-hidden="true">←</span>
        {t('cv.back')}
      </a>
      <a class="btn" href={cvPdfPath(lang)} download>
        {t('cv.download')}
        <span class="arrow" aria-hidden="true">
          ↓
        </span>
      </a>
      <button class="btn btn--ghost" type="button" data-print>
        {t('cv.print')}
      </button>
    </div>

    <article class="sheet" aria-label={`${t('cv.title')} · ${profile.name}`}>
      <header class="head">
        <div>
          <h1 class="name">{profile.name}</h1>
          <p class="role">{t('hero.role')}</p>
          <a class="portfolio" href={portfolioUrl}>
            <span class="portfolio__label">{t('cv.portfolio')}</span>
            <span>{site}</span>
          </a>
        </div>
        <div class="head__side">
          <ul class="contact" role="list">
            <li>
              {profile.location.city}, {lang === 'es' ? 'España' : profile.location.country}
            </li>
            <li>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
            </li>
            {linkedin && (
              <li>
                <a href={linkedin.href}>linkedin.com/{linkedin.handle}</a>
              </li>
            )}
            {github && (
              <li>
                <a href={github.href}>github.com/{github.handle.replace('@', '')}</a>
              </li>
            )}
          </ul>
          <a class="qr" href={portfolioUrl} aria-label={`${t('cv.portfolio')}: ${site}`} set:html={qr} />
        </div>
      </header>

      <dl class="highlights">
        {profile.stats.map((s) => (
          <div>
            <dt>{t(s.key)}</dt>
            <dd>
              {'prefix' in s ? s.prefix : ''}
              {s.value}
              {s.suffix}
            </dd>
          </div>
        ))}
      </dl>
      <p class="availability">{profile.availability[lang]}</p>

      <section class="block">
        <h2>{t('cv.summary')}</h2>
        <div class="prose">
          {profile.bio[lang].map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>

      <section class="block">
        <h2>{t('cv.experience')}</h2>
        <ol class="entries" role="list">
          {experience.map((job) => (
            <li class="entry">
              <div class="entry__head">
                <h3>
                  {job.role[lang]} <span class="at">· {job.company}</span>
                </h3>
                <span class="when">{job.period[lang]}</span>
              </div>
              <p>{job.summary[lang]}</p>
              <p class="tags">{job.tags.join(' · ')}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="block">
        <h2>{t('cv.projects')}</h2>
        <ol class="entries" role="list">
          {projects.map((p) => (
            <li class="entry">
              <div class="entry__head">
                <h3>
                  {p.title} <span class="at">· {p.role[lang]}</span>
                </h3>
                <span class="when">{p.year}</span>
              </div>
              <p>{p.tagline[lang]}</p>
              <p class="tags">{p.stack.slice(0, 7).join(' · ')}</p>
              <a class="case" href={workUrl(p.slug)}>
                {workUrl(p.slug).host}
                {workUrl(p.slug).pathname}
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="block">
        <h2>{t('cv.skills')}</h2>
        <dl class="skills">
          {stack.map((group) => (
            <div>
              <dt>{group.group[lang]}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="block">
        <h2>{t('cv.education')}</h2>
        <div class="entry">
          <div class="entry__head">
            <h3>{education.degree[lang]}</h3>
            <span class="when">{education.period}</span>
          </div>
          <p>{education.school}</p>
        </div>
      </section>

      <section class="block">
        <h2>{t('cv.languages')}</h2>
        <p>{profile.languages[lang]}</p>
      </section>
    </article>
  </div>
</Base>

<style>
  /* The CV is a document: it keeps a paper look in both themes and prints to A4. */
  .cv-page {
    padding-top: 7rem;
    padding-bottom: 5rem;
  }
  .cv-close {
    position: fixed;
    top: 5.5rem;
    right: var(--gutter);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(10px);
    color: var(--fg);
    transition:
      transform 0.4s var(--ease-out),
      background-color 0.3s,
      color 0.3s;
  }
  .cv-close:hover,
  .cv-close:focus-visible {
    transform: rotate(90deg);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .sheet {
    --ink: #15161a;
    --ink-soft: #3d3e44;
    --ink-muted: #6a6a66;
    --rule: #dcd9d1;
    --mark: #4a6400;
    max-width: 210mm;
    margin-inline: auto;
    padding: 16mm 16mm 14mm;
    background: #fdfcf9;
    color: var(--ink);
    border-radius: 6px;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.5);
    font-size: 10pt;
    line-height: 1.45;
  }
  .head {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 5mm;
    border-bottom: 1.5px solid var(--ink);
  }
  .name {
    font-size: 24pt;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .role {
    margin-top: 1.5mm;
    font-family: var(--font-mono);
    font-size: 8.5pt;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mark);
  }
  .portfolio {
    display: inline-flex;
    align-items: baseline;
    gap: 2mm;
    margin-top: 3mm;
    padding: 1.2mm 3mm;
    border: 1px solid var(--mark);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--mark);
  }
  .portfolio__label {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .head__side {
    display: flex;
    align-items: flex-start;
    gap: 5mm;
  }
  .qr {
    display: block;
    width: 21mm;
    height: 21mm;
    flex-shrink: 0;
  }
  .qr :global(svg) {
    width: 100%;
    height: 100%;
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4mm;
    margin-top: 4mm;
  }
  .highlights div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5mm;
    padding-left: 3mm;
    border-left: 2px solid var(--mark);
  }
  .highlights dd {
    font-size: 15pt;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .highlights dt {
    font-size: 7.5pt;
    line-height: 1.3;
    color: var(--ink-muted);
  }
  .case {
    display: inline-block;
    margin-top: 0.6mm;
    font-family: var(--font-mono);
    font-size: 7.5pt;
    color: var(--mark);
  }
  .contact {
    display: grid;
    gap: 0.5mm;
    text-align: right;
    font-size: 8.5pt;
    color: var(--ink-soft);
  }
  .contact a {
    color: inherit;
  }
  .availability {
    margin-top: 3mm;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--ink-muted);
  }
  /* Block layout (not grid) with an absolutely placed label, so long sections can break across pages. */
  .block {
    position: relative;
    padding: 4.5mm 0 4.5mm 36mm;
    border-bottom: 1px solid var(--rule);
  }
  .block:last-child {
    border-bottom: 0;
  }
  .block h2 {
    position: absolute;
    top: 4.5mm;
    left: 0;
    width: 30mm;
    padding-top: 0.6mm;
    font-family: var(--font-mono);
    font-size: 7.5pt;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .prose {
    display: grid;
    gap: 2mm;
    color: var(--ink-soft);
  }
  .entries > * + * {
    margin-top: 3.5mm;
  }
  .entry {
    break-inside: avoid;
  }
  .entry p {
    color: var(--ink-soft);
  }
  .entry__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
    margin-bottom: 0.8mm;
  }
  .entry__head h3 {
    font-size: 10.5pt;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .at {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .when {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--ink-muted);
  }
  .tags {
    margin-top: 0.8mm;
    font-family: var(--font-mono);
    font-size: 7.5pt;
    color: var(--ink-muted) !important;
  }
  .skills {
    display: grid;
    gap: 1.2mm;
  }
  .skills div {
    display: grid;
    grid-template-columns: 34mm 1fr;
    gap: 3mm;
  }
  .skills dt {
    font-weight: 600;
  }
  .skills dd {
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .cv-close {
      top: auto;
      bottom: 1.25rem;
    }
    .head__side {
      flex-direction: column-reverse;
    }
    .highlights {
      grid-template-columns: 1fr;
    }
    .sheet {
      padding: 1.5rem 1.25rem;
      font-size: 0.9rem;
    }
    .head {
      flex-direction: column;
      gap: 1rem;
    }
    .contact {
      text-align: left;
    }
    .block {
      padding-left: 0;
    }
    .block h2 {
      position: static;
      width: auto;
      margin-bottom: 0.5rem;
    }
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .entry__head {
      flex-direction: column;
      gap: 0.1rem;
    }
  }

  @page {
    size: A4;
    margin: 13mm 15mm 12mm;
  }
  @media print {
    :global(.nav),
    :global(.footer),
    :global(.cursor),
    :global(.skip-link),
    :global(.cmd),
    .cv-actions,
    .cv-close {
      display: none !important;
    }
    :global(body) {
      background: #fff !important;
    }
    :global(body::after) {
      display: none;
    }
    .cv-page {
      padding: 0;
      max-width: none;
    }
    .sheet {
      max-width: none;
      border-radius: 0;
      box-shadow: none;
      padding: 0;
      background: #fff;
    }
    a {
      text-decoration: none;
    }
  }
</style>

<script>
  /** Go back to wherever the visitor opened the CV from; fall back to the link's own target. */
  function closeCv(fallback: string) {
    const cameFromSite = document.referrer && new URL(document.referrer).origin === location.origin;
    if (cameFromSite && history.length > 1) history.back();
    else location.href = fallback;
  }

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-cv-actions]')) return;
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    document.querySelectorAll<HTMLAnchorElement>('[data-cv-close]').forEach((link) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        closeCv(link.href);
      }),
    );
    const onKey = (e: KeyboardEvent) => {
      // Esc closes the CV unless another layer (command palette, menu) is open and handles it.
      if (e.key !== 'Escape' || document.querySelector('dialog[open]') || document.documentElement.style.overflow === 'hidden') return;
      const link = document.querySelector<HTMLAnchorElement>('[data-cv-close]');
      if (link) closeCv(link.href);
    };
    document.addEventListener('keydown', onKey);
    document.addEventListener('astro:before-swap', () => document.removeEventListener('keydown', onKey), { once: true });
  });
</script>
